NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=dawoodtech_community
# Local development only: let TypeORM sync the schema on startup. Never on the live server.
DB_SYNCHRONIZE=true

# Reverse proxies in front of the API (cPanel/LiteSpeed = 1) — for real visitor IPs in rate limits.
TRUST_PROXY=1

# Required outside NODE_ENV=development/test — use long random values (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_EMAIL_TOKEN_SECRET=change-me-email-token-secret

CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Leave SMTP_HOST empty to log verification/reset emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DawoodTech Community <no-reply@dawoodtechnextgen.com>

# SMTP using TaskDesk's key names (these take precedence over the SMTP_* keys above).
# MAIL_ENCRYPTION=ssl -> implicit TLS (port 465); tls -> STARTTLS (port 587).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@dawoodtechnextgen.com
MAIL_FROM_NAME=DawoodTech Community

# Most verification emails the background retry sends per rolling hour. Keep it
# well below your mail server's hourly cap so signup / password-reset emails
# always have room. E.g. server allows 30/hour -> 20 here.
EMAIL_HOURLY_LIMIT=20

# Web Push notifications (phone / desktop, even when the app is closed).
# Generate ONE pair per environment and keep it: changing it breaks every
# existing subscription.   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@dawoodtechnextgen.com

# The community's calendar: when "today" starts for daily questions and streaks.
APP_TIMEZONE=Asia/Karachi

# Members with this many approved posts (and no rejection in 30 days) skip the
# review queue. 0 = review every member's posts. Admins/supervisors always skip.
AUTO_APPROVE_AFTER=3

