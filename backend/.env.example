NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=dawoodtech_community

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_EMAIL_TOKEN_SECRET=change-me-email-token-secret

CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Leave SMTP_HOST empty to log verification/reset emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DawoodTech Community <no-reply@dawoodtechnextgen.com>

# SMTP using TaskDesk's key names (these take precedence over the SMTP_* keys above).
# MAIL_ENCRYPTION=ssl -> implicit TLS (port 465); tls -> STARTTLS (port 587).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@dawoodtechnextgen.com
MAIL_FROM_NAME=DawoodTech Community

# --- New-post emails to TaskDesk interns ---
# Public site used for "View Post" links in emails.
COMMUNITY_URL=https://community.dawoodtechnextgen.com
# Public URL of this backend API — uploaded post images / avatars in emails load from here.
API_PUBLIC_URL=
# TaskDesk database (read-only; use a SELECT-only MySQL user).
TASKDESK_DB_HOST=127.0.0.1
TASKDESK_DB_NAME=task_management
TASKDESK_DB_USER=
TASKDESK_DB_PASS=
# dry_run = log recipients only | test = email POST_EMAIL_TEST_RECIPIENT only | live = email all interns
POST_EMAIL_MODE=dry_run
POST_EMAIL_TEST_RECIPIENT=
POST_EMAIL_BATCH_SIZE=50
POST_EMAIL_DELAY_MS=1000
# Most queued emails (new-post + like/comment/follow) sent per rolling hour.
# Keep it well below your mail server's hourly cap, so signup / password-reset
# emails always have room. E.g. server allows 30/hour -> 20 here.
EMAIL_HOURLY_LIMIT=20
# New posts go out as ONE daily digest email per person, built on the first
# cron run after this hour (0-23, in DIGEST_TIMEZONE).
DIGEST_HOUR=9
DIGEST_TIMEZONE=Asia/Karachi
# Like/comment/reply emails to community members (defaults to POST_EMAIL_MODE).
# test mode sends them all to POST_EMAIL_TEST_RECIPIENT.
ACTIVITY_EMAIL_MODE=dry_run
