NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=dawoodtech_community

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_EMAIL_TOKEN_SECRET=change-me-email-token-secret

CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Leave SMTP_HOST empty to log verification/reset emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DawoodTech Community <no-reply@dawoodtechnextgen.com>
