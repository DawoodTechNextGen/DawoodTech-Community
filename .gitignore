# Backend (Node/NestJS)
# dist/ is intentionally committed — cPanel deploys the compiled output directly,
# rebuild + commit it whenever backend/src changes (npm run build inside backend/).
backend/node_modules/
backend/coverage/
backend/*.tsbuildinfo
backend/.env*
!backend/.env.example
# cPanel app root is backend/dist — the cron CLI reads its .env from there
backend/dist/.env
backend/uploads/*
!backend/uploads/.gitkeep

# Web (Next.js)
web/node_modules/
web/.next/
web/out/
web/.env*
!web/.env.example

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Local-only notes (test account passwords)
*.local.md
